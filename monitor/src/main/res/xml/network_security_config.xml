<?xml version="1.0" encoding="utf-8"?>
<!--
  允许明文 HTTP，原因同设备端：局域网用 http://192.168.x.x:port。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
