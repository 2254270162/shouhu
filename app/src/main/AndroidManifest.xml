<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 定位权限：FINE 用于 GPS/高精度，COARSE 用于网络定位（Android 12+ 用户可只授予大致位置） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 相机权限：本地预览与远程拍照用 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 守护前台服务：常驻通知 + 后台位置上报 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 13+ 读取相册需要；用户在系统弹窗里可拒绝，拒绝后仅本地拍照可用 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 重启后恢复守护（只在用户之前明确开启过时才恢复） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      读取前台应用所需。
      注意：这是「特殊权限」，系统不提供运行时弹窗，只能引导用户到设置页手动开启。
      缺少这条声明时，设置页的「使用情况访问」列表里根本不会出现本应用。
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 没有 GPS 硬件的设备（部分平板）也能安装 -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <!-- 没有摄像头的设备也能安装，此时拍照按钮会给出提示 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocateMe">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LocateMe"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 守护服务：类型必须声明，否则 Android 14 会拒绝启动 -->
        <service
            android:name=".guard.GuardService"
            android:exported="false"
            android:foregroundServiceType="location|camera" />

        <!-- 开机恢复守护；仅当用户之前开启过且仍配对时才启动 -->
        <receiver
            android:name=".guard.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 把照片临时共享给系统相机，避免申请存储权限 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
